# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store

# credential shapes — precautionary, nothing here matches today. The `.env*`
# rule below already covers the secrets this app actually uses; these catch
# the accident.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials
credentials.json
kubeconfig

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/

# sqlite (better-sqlite3 auth/app databases, opened by instrumentation.ts)
/db/

# Maintainer's local working notes and local-only deploy config. These live on
# disk and are deliberately not part of the published tree: they hold planning
# state, measured failure data, and host-specific configuration that would only
# mislead a reader of this repository.
/ROADMAP.md
/DECISIONS.md
/CHOICES.md
/CLAUDE.local.md
/ios/
/.claude/
/evals/runs/
/railway.json

# Pulled out of the published tree 2026-08-28: the 350G emissions/EGR tampering
# inspection guide. It is a different document kind from the field reports and
# is kept outside the repo.
/docs/*tampering*
