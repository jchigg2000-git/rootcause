# --- Inference providers ----------------------------------------------------
# Two providers, two wire protocols. A model's provider comes from
# MODEL_CATALOG in app/lib/settings.ts; only that provider's key is needed.
# Both are billable — server-only, never NEXT_PUBLIC_* or VITE_*.

# Hugging Face router (OpenAI-compatible).
HF_TOKEN=hf_your_server_side_token
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# Anthropic Messages API. Not reachable via HF_BASE_URL — different protocol.
ANTHROPIC_API_KEY=sk-ant-your-server-side-key


# --- Access -----------------------------------------------------------------
# There is nothing to set here, and that is the important part: RootCause has
# NO AUTHENTICATION. There is no sign-in, no account and no API key of its own.
# Anyone who can open the port can spend the provider keys above.
#
# Run it on localhost, or put your own authentication in front of it. Do not
# expose it directly to the internet. See SECURITY.md.


# --- Runtime ----------------------------------------------------------------
# Where the SQLite files live. Point this at a persistent path in any
# deployment, or every restart begins with an empty database. Defaults to ./db.
# DB_DIR=/data

# Set to "production" to enable HSTS. Nothing else reads it.
ENVIRONMENT=development
