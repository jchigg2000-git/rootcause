# --- Inference providers ----------------------------------------------------
# Two providers, two wire protocols. A model's provider comes from
# MODEL_CATALOG in app/lib/settings.ts; only that provider's key is needed.
# Both are billable — server-only, never NEXT_PUBLIC_* or VITE_*.

# Hugging Face router (OpenAI-compatible).
HF_TOKEN=hf_your_server_side_token
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# Anthropic Messages API. Not reachable via HF_BASE_URL — different protocol.
ANTHROPIC_API_KEY=sk-ant-your-server-side-key

# --- Auth -------------------------------------------------------------------
# There is nothing to set here. Sign-in takes either an access code issued from
# Settings, or the owner's SKELETON KEY, which is generated on first boot and
# written to $DB_DIR/skeleton.key (./db/skeleton.key locally). The key is
# printed to the log exactly once, on the boot that creates it.
#
# Read it back any time:      cat db/skeleton.key
# Deployed:                   cat $DB_DIR/skeleton.key on the host
#
# Rotate it by deleting the file and restarting; the owner account and
# everything it owns survive, because the account is keyed on a fixed id.

# Set to "false" only for plain-HTTP local dev; anything else keeps Secure on.
COOKIE_SECURE=false
# Set to "production" to enable HSTS.
ENVIRONMENT=development


# --- Deployment -------------------------------------------------------------
# Where the two SQLite files live. Must point at a mounted volume in any
# deployment, or the database is lost on every restart. Defaults to ./db.
# DB_DIR=/data
