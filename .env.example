# --- Inference providers ----------------------------------------------------
# Two providers, two wire protocols. A model's provider comes from
# MODEL_CATALOG in app/lib/settings.ts. Both keys are billable — server-only,
# never NEXT_PUBLIC_* or VITE_*.

# Anthropic Messages API. THIS IS THE ONE A FRESH INSTALL NEEDS: the shipped
# default model is claude-sonnet-5, so without this key the first diagnosis
# fails with "The selected model's provider is not configured on the server".
# Parts lookup is Anthropic-only regardless of the setting, and so is the
# eval harness in evals/.
ANTHROPIC_API_KEY=sk-ant-your-server-side-key

# Hugging Face router (OpenAI-compatible). Not reachable via the Anthropic key
# — different protocol. To actually run on Hugging Face you also have to pick
# an HF model (or "Server default (HF_MODEL)") in /settings; setting these
# alone changes nothing, because the stored default wins.
HF_TOKEN=hf_your_server_side_token
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1


# --- Access -----------------------------------------------------------------
# There is nothing to set here, and that is the important part: RootCause has
# NO AUTHENTICATION. There is no sign-in, no account and no API key of its own.
# Anyone who can open the port can spend the provider keys above.
#
# Run it on localhost, or put your own authentication in front of it. Do not
# expose it directly to the internet. See SECURITY.md.


# --- Runtime ----------------------------------------------------------------
# Where the SQLite files live. Point this at a persistent path in any
# deployment, or every restart begins with an empty database. Defaults to ./db.
# DB_DIR=/data

# Set to "production" to enable HSTS. Nothing else reads it.
ENVIRONMENT=development

# Set to 1 when running behind a reverse proxy that terminates TLS, so the
# server trusts X-Forwarded-Proto. Without it, redirects are built from the
# plain-HTTP request the proxy makes on the inside and downgrade the browser.
# VINEXT_TRUST_PROXY=1
