{
  "name": "rootcause",
  "version": "0.1.0",
  "private": true,
  "description": "Heavy-equipment diagnostic intake and field reporting: an operator describes a machine and a symptom, answers a short model-led interview, and downloads a standalone HTML field report.",
  "license": "Apache-2.0",
  "author": "Justin Higgins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchigg2000-git/rootcause.git"
  },
  "homepage": "https://github.com/jchigg2000-git/rootcause#readme",
  "bugs": {
    "url": "https://github.com/jchigg2000-git/rootcause/issues"
  },
  "keywords": [
    "heavy-equipment",
    "diagnostics",
    "field-service",
    "field-report",
    "llm",
    "anthropic"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5211",
    "build": "vinext build",
    "start": "exec vinext start --port ${PORT:-5211}",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "better-sqlite3": "^13.0.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "0.0.50",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
